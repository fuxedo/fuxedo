*RESOURCES
SECURITY NONE
MASTER tuxapp
MODEL SHM
IPCKEY @IPCKEY@
MAXACCESSERS 30
MAXSERVERS 20
MAXSERVICES 20
BLOCKTIME 20

*MACHINES
"@UNAME@" LMID=tuxapp APPDIR="@CURDIR@" TUXCONFIG="@CURDIR@/tuxconfig" TUXDIR="@TUXDIR@" TLOGDEVICE="@CURDIR@/TLOG" TLOGSIZE=100

*GROUPS
APP LMID=tuxapp GRPNO=1
ORA LMID=tuxapp GRPNO=2 TMSNAME=TMS_ORACLE TMSCOUNT=2 OPENINFO="@OPENINFO@"

*SERVERS
orasvr SRVGRP=ORA SRVID=10 MIN=1 MAX=1 CLOPT="-A"

*SERVICES
INSERT AUTOTRAN=Y TRANTIME=10
INSERTFAIL AUTOTRAN=Y TRANTIME=10
INSERTOWN TRANTIME=10
