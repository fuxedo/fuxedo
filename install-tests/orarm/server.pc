// Oracle XA test server, Pro*C edition. SQLLIB adopts the branch the
// TMS opened for this group at xa_open, so EXEC SQL rides the global
// transaction that fuxedo begins at dispatch (AUTOTRAN) or that the
// caller propagated; no explicit branch join is needed, the way the
// classic samples work.
//
// INSERT      plain service; AUTOTRAN=Y makes the platform begin a
//             transaction for it when the caller has none
// INSERTFAIL  returns TPFAIL; with AUTOTRAN=Y the outcome is an abort
// INSERTOWN   begins its own transaction, never commits; the platform
//             aborts it at tpreturn and answers the caller TPESVCERR
//             (verified on Oracle 12.2.2: no row lands)
// SUBMIT      the write side of the two-RM pipeline: in ONE transaction
//             insert the row (Oracle RM) and tpenqueue its id to /Q
//             (TUXEDO/QM RM, the second RM)
// JOBS        the read side, invoked by TMQFORWARD on the JOBS queue:
//             in the forwarded transaction read the row by id and mark
//             it processed. A not-yet-visible row fails on purpose: the
//             two RMs complete phase 2 in either order, so /Q can be
//             visible before Oracle's commit lands, and the failed
//             forward aborts the dequeue - the message is redelivered.

#include <atmi.h>
#include <fml32.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <userlog.h>

// EXEC SQL INCLUDE SQLCA; makes proc paste the SQLCA state (the
// lowercase sqlca instance) into the generated file
EXEC SQL INCLUDE SQLCA;

#include "orarm.h"

// proc re-emission can drop library declarations the generated file
// relies on
extern unsigned int sleep(unsigned int);

EXEC SQL BEGIN DECLARE SECTION;
static long h_id;
static char h_tag[64];
static long h_count;
EXEC SQL END DECLARE SECTION;

static int parse_id_tag(TPSVCINFO *msg) {
  h_id = 0;
  if (Fget32((FBFR32 *)msg->data, FLD_ID, 0, (char *)&h_id, 0) == -1) {
    tperrno = TPEINVAL;
    return -1;
  }
  memset(h_tag, 0, sizeof(h_tag));
  FLDLEN32 len = sizeof(h_tag);
  if (Fget32((FBFR32 *)msg->data, FLD_TAG, 0, h_tag, &len) == -1) {
    tperrno = TPEINVAL;
    return -1;
  }
  h_tag[sizeof(h_tag) - 1] = '\0';
  if (strcmp(h_tag, "slow") == 0) {
    sleep(2);
  }
  return 0;
}

static int insert_row(void) {
  EXEC SQL INSERT INTO fuxedo_xa_test (id, tag, status)
      VALUES (:h_id, :h_tag, 'new');
  if (sqlca.sqlcode != 0) {
    userlog("ORARM: insert id=%ld failed: %ld %.70s", h_id,
            (long)sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
    tperrno = TPESYSTEM;
    return -1;
  }
  return 0;
}

static int enqueue_job(void) {
  char text[128];
  snprintf(text, sizeof(text), "id=%ld;tag=%s", h_id, h_tag);
  char *payload = tpalloc((char *)"STRING", nullptr,
                          (long)strlen(text) + 1);
  if (payload == nullptr) {
    userlog("ORARM: tpalloc failed: %s", tpstrerror(tperrno));
    return -1;
  }
  strcpy(payload, text);
  TPQCTL qctl;
  memset(&qctl, 0, sizeof(qctl));
  int rc = tpenqueue((char *)"QSPACE", (char *)"JOBS",
                     &qctl, payload, 0, TPNOFLAGS);
  tpfree(payload);
  if (rc == -1) {
    userlog("ORARM: tpenqueue id=%ld failed: %s", h_id, tpstrerror(tperrno));
    return -1;
  }
  return 0;
}

void INSERT(TPSVCINFO *msg) {
  if (parse_id_tag(msg) == -1 || insert_row() == -1) {
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }
  tpreturn(TPSUCCESS, 0, msg->data, 0, 0);
}

void INSERTFAIL(TPSVCINFO *msg) {
  if (parse_id_tag(msg) == -1 || insert_row() == -1) {
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }
  tpreturn(TPFAIL, 0, msg->data, 0, 0);
}

void INSERTOWN(TPSVCINFO *msg) {
  if (tpbegin(30, 0) == -1) {
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }
  if (parse_id_tag(msg) == -1 || insert_row() == -1) {
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }
  // no commit: the platform decides at tpreturn (pinned: TPSUCCESS
  // commits a server-begun transaction)
  tpreturn(TPSUCCESS, 0, msg->data, 0, 0);
}

void SUBMIT(TPSVCINFO *msg) {
  if (parse_id_tag(msg) == -1 || insert_row() == -1 ||
      enqueue_job() == -1) {
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }
  tpreturn(TPSUCCESS, 0, msg->data, 0, 0);
}

// ids whose first delivery already failed; the qretry batch fails once
// per id, deterministically exercising the abort-and-redeliver path
static long g_retried[16];
static int g_retried_n;

void JOBS(TPSVCINFO *msg) {
  long id = 0;
  char tag[32] = {0};
  int i;
  if (msg->data == nullptr ||
      sscanf((const char *)msg->data, "id=%ld;tag=%31[^;]", &id, tag) < 1) {
    tperrno = TPEINVAL;
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }

  h_id = id;
  EXEC SQL SELECT COUNT(*) INTO :h_count FROM fuxedo_xa_test
      WHERE id = :h_id;
  if (sqlca.sqlcode != 0) {
    userlog("ORARM: select id=%ld failed: %ld %.70s", id,
            (long)sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }
  if (h_count == 0) {
    // /Q committed before Oracle: fail so the dequeue aborts and the
    // message comes back
    userlog("ORARM: JOBS id=%ld not visible yet; failing for redelivery",
            id);
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }

  int seen = 0;
  for (i = 0; i < g_retried_n; i++) {
    if (g_retried[i] == id) {
      seen = 1;
      break;
    }
  }
  if (strcmp(tag, "qretry") == 0 && !seen) {
    if (g_retried_n < 16) {
      g_retried[g_retried_n++] = id;
    }
    userlog("ORARM: JOBS id=%ld forced first-delivery failure", id);
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }

  EXEC SQL UPDATE fuxedo_xa_test SET status = 'processed' WHERE id = :h_id;
  if (sqlca.sqlcode != 0) {
    userlog("ORARM: update id=%ld failed: %ld %.70s", id,
            (long)sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
    tpreturn(TPFAIL, 0, NULL, 0, 0);
  }
  tpreturn(TPSUCCESS, 0, NULL, 0, 0);
}

int tpsvrinit(int argc, char **argv) {
  (void)argc;
  (void)argv;
  if (tpadvertise("INSERT", INSERT) == -1 ||
      tpadvertise("INSERTFAIL", INSERTFAIL) == -1 ||
      tpadvertise("INSERTOWN", INSERTOWN) == -1 ||
      tpadvertise("SUBMIT", SUBMIT) == -1 ||
      tpadvertise("JOBS", JOBS) == -1) {
    return -1;
  }
  // open the resource manager for this group; failures must fail the
  // boot (xa_open errors surface here)
  if (tpopen() == -1) {
    userlog("ORARM: tpopen failed: %s", tpstrerror(tperrno));
    return -1;
  }
  return 0;
}

void tpsvrdone(void) {
  EXEC SQL ROLLBACK RELEASE;
  tpclose();
}
