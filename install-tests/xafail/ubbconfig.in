*RESOURCES
IPCKEY		47693
DOMAINID	xafail
MASTER	tuxapp
MAXACCESSERS	20
MAXSERVERS	10
MAXSERVICES	10
MAXGTT		20
MODEL		SHM
SECURITY	NONE

*MACHINES
"@UNAME@"
		LMID=tuxapp
		APPDIR="@CURDIR@"
		TUXCONFIG="@CURDIR@/tuxconfig"
		TUXDIR="@TUXDIR@"
		TLOGDEVICE="@CURDIR@/tlog"
		TLOGNAME=tlog
		TLOGOFFSET=0
		TLOGSIZE=100

*GROUPS
G1		LMID=tuxapp GRPNO=1 OPENINFO="XAFAIL:@CURDIR@/knob" \
		TMSNAME=TMSXAF TMSCOUNT=2

*SERVERS
worker		SRVGRP=G1 SRVID=1 CLOPT="-A"
