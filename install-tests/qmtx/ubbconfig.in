*RESOURCES
IPCKEY		47691
DOMAINID	qmtx
MASTER		tuxapp
MAXACCESSERS	20
MAXSERVERS	10
MAXSERVICES	10
MAXGTT		20
MODEL		SHM
SECURITY	NONE

*MACHINES
"@UNAME@"
		LMID=tuxapp
		APPDIR="@CURDIR@"
		TUXCONFIG="@CURDIR@/tuxconfig"
		TUXDIR="@TUXDIR@"
		TLOGDEVICE="@CURDIR@/tlog"
		TLOGNAME=tlog
		TLOGOFFSET=0
		TLOGSIZE=100

*GROUPS
G1		LMID=tuxapp GRPNO=1 OPENINFO="TUXEDO/QM:@CURDIR@/queues:QS" \
		TMSNAME=TMSQM TMSCOUNT=2

*SERVERS
pump		SRVGRP=G1 SRVID=1 CLOPT="-A"
