*RESOURCES
SECURITY NONE
MASTER tuxapp
MODEL SHM
IPCKEY 47695

*MACHINES
"@UNAME@" LMID=tuxapp APPDIR="@CURDIR@" TUXCONFIG="@CURDIR@/tuxconfig" TUXDIR="@TUXDIR@"

*GROUPS
APP LMID=tuxapp GRPNO=1
QUE LMID=tuxapp GRPNO=2 TMSNAME=TMS_QM TMSCOUNT=2
	OPENINFO="TUXEDO/QM:@CURDIR@/QUE:QSPACE"

*SERVERS
# the TMQFORWARD target runs in the TMS-equipped group: the forwarded
# call joins the forwarding transaction, and a transaction reaching a
# group without a TMS fails TPETRAN
qsvc SRVGRP=QUE SRVID=1 CLOPT="-A"
TMQUEUE SRVGRP=QUE SRVID=2 CLOPT="-s QSPACE:TMQUEUE -- "
TMQFORWARD SRVGRP=QUE SRVID=5 CLOPT="-- -q STRING -i 1"

*SERVICES
STRING SRVGRP=QUE
