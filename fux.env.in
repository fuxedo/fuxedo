# fuxedo environment, the shape of the platform's tux.env: one source
# puts the fuxedo toolchain on PATH and the shared libraries on the
# loader path. Shells and scripts source this file:
#
#     . "$TUXDIR/fux.env"      (after export TUXDIR=<prefix>)
#
# TUXDIR defaults to the configured prefix but a preset value wins, so
# a DESTDIR test tree works the same way. TUXCONFIG stays per-domain,
# like the platform.
TUXDIR=${TUXDIR:-@prefix@}; export TUXDIR
PATH=$TUXDIR/bin:${PATH:-}; export PATH
LD_LIBRARY_PATH=$TUXDIR/lib:${LD_LIBRARY_PATH:-}; export LD_LIBRARY_PATH
SHLIB_PATH=$TUXDIR/lib:${SHLIB_PATH:-}; export SHLIB_PATH
LIBPATH=$TUXDIR/lib:${LIBPATH:-}; export LIBPATH
