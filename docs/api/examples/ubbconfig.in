*RESOURCES
SECURITY NONE
MASTER tuxapp
MODEL SHM
IPCKEY 41003

*MACHINES
"@UNAME@" LMID=tuxapp APPDIR="@CURDIR@" TUXCONFIG="@CURDIR@/tuxconfig" TUXDIR="@TUXDIR@" TLOGDEVICE="@CURDIR@/TLOG"

*GROUPS
GROUP1 LMID=tuxapp GRPNO=1
QUE1 LMID=tuxapp GRPNO=2 TMSNAME=TMS_QM TMSCOUNT=2 OPENINFO="TUXEDO/QM:@CURDIR@/QUE:DOCS"

*SERVERS
apisvr SRVGRP=GROUP1 SRVID=1 MIN=1 MAX=1 CLOPT="-A"
advsvr SRVGRP=GROUP1 SRVID=2 MIN=1 MAX=1 MINDISPATCHTHREADS=2 MAXDISPATCHTHREADS=2 CLOPT="-A"
convsvr SRVGRP=GROUP1 SRVID=3 MIN=1 MAX=1 CLOPT="-A"
TMQUEUE SRVGRP=QUE1 SRVID=10 MIN=1 MAX=1 CLOPT="-s DOCS:TMQUEUE -- "

*SERVICES
TOUPPER
FORWARD
GREET
GREETX
CHAT
PRIO
